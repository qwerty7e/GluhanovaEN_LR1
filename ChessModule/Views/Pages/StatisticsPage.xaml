<Page x:Class="ChessModule.Windows.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EAF1F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="RootGrid" MinHeight="720" Margin="30">
            <Border Background="#D7E3F1"
                    CornerRadius="24"
                    Padding="35"
                    Width="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Статистика"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#243B55"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <Border Background="White"
                            CornerRadius="14"
                            Padding="20"
                            Margin="0,0,0,25">
                        <TextBlock x:Name="StatsBlock"
                                   FontSize="17"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Button Content="История партий"
                            Height="46"
                            Margin="0,0,0,10"
                            Click="History_Click"/>

                    <Button Content="Назад"
                            Height="46"
                            Click="Close_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>