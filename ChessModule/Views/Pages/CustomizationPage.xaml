<Page x:Class="ChessModule.Windows.CustomizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EAF1F8">

    <Grid x:Name="RootGrid" Margin="30">
        <Border Background="#D7E3F1"
                CornerRadius="24"
                Padding="25">

            <DockPanel>
                <TextBlock Text="Кастомизация"
                           DockPanel.Dock="Top"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#243B55"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <TextBlock Text="Цвет доски" FontSize="17" Margin="0,0,0,6"/>
                    <ComboBox x:Name="BoardComboBox" Height="38" Margin="0,0,0,14"/>

                    <TextBlock Text="Цвет фигур" FontSize="17" Margin="0,0,0,6"/>
                    <ComboBox x:Name="PieceColorComboBox" Height="38" Margin="0,0,0,14"/>

                    <TextBlock Text="Форма фигур" FontSize="17" Margin="0,0,0,6"/>
                    <ComboBox x:Name="PieceShapeComboBox" Height="38" Margin="0,0,0,14"/>

                    <Button Content="Применить"
                            Height="46"
                            Margin="0,10,0,0"
                            Click="Apply_Click"/>
                </StackPanel>

                <Button Content="Назад"
                        DockPanel.Dock="Bottom"
                        Height="46"
                        Margin="0,20,0,0"
                        Click="Close_Click"/>

                <DataGrid x:Name="RewardsGrid"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          FontSize="15"
          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="170"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding RewardType}" Width="130"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Page>