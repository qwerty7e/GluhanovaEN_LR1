<Page x:Class="ChessModule.Windows.AchievementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EAF1F8">

    <Grid x:Name="RootGrid" Margin="30">
        <Border Background="#D7E3F1"
                CornerRadius="24"
                Padding="25">

            <DockPanel>
                <TextBlock Text="Достижения"
                           DockPanel.Dock="Top"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#243B55"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <Button Content="Назад"
                        DockPanel.Dock="Bottom"
                        Height="46"
                        Margin="0,20,0,0"
                        Click="Close_Click"/>

                <TabControl>
                    <TabItem Header="Полученные">
                        <DataGrid x:Name="ReceivedAchievementsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  FontSize="15"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="180"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Условие" Binding="{Binding ConditionText}" Width="180"/>
                                <DataGridTextColumn Header="Дата получения" Binding="{Binding DateReceived, StringFormat=dd.MM.yyyy HH:mm}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Не полученные">
                        <DataGrid x:Name="LockedAchievementsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  FontSize="15"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="180"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Условие" Binding="{Binding ConditionText}" Width="180"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</Page>