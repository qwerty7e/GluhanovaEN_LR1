<Page x:Class="ChessModule.Windows.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EAF1F8">

    <Grid x:Name="RootGrid" Margin="30">
        <Border Background="#D7E3F1"
                CornerRadius="24"
                Padding="25">

            <DockPanel>
                <TextBlock Text="История партий"
                           DockPanel.Dock="Top"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#243B55"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <Button Content="Назад"
                        DockPanel.Dock="Bottom"
                        Height="46"
                        Margin="0,20,0,0"
                        Click="Close_Click"/>

                <DataGrid x:Name="HistoryGrid"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          FontSize="15"
          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="60"/>
                        <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="120"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding GameDate}" Width="160"/>
                        <DataGridTextColumn Header="Режим" Binding="{Binding OpponentType}" Width="160"/>
                        <DataGridTextColumn Header="Сложность" Binding="{Binding GameDifficulty}" Width="140"/>
                        <DataGridTextColumn Header="Ходов" Binding="{Binding MovesCount}" Width="90"/>
                        <DataGridTextColumn Header="Длительность" Binding="{Binding DurationText}" Width="120"/>
                        <DataGridTextColumn Header="Причина завершения" Binding="{Binding FinishReason}" Width="180"/>
                        <DataGridTextColumn Header="Победитель" Binding="{Binding Winner}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Page>