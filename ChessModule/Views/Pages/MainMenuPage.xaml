<Page x:Class="ChessModule.Windows.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EAF1F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="RootGrid" MinHeight="720" Margin="30">
            <Border Background="#D7E3F1"
                    CornerRadius="24"
                    Padding="40"
                    Width="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Chess Module"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="#243B55"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock x:Name="WelcomeText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="ShortStatsText"
                               FontSize="15"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,28"/>

                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button Height="90" Margin="8" Click="NewGame_Click">
                            <StackPanel>
                                <Image Source="/Resources/Images/1.png" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Новая партия" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="90" Margin="8" Click="LoadGame_Click">
                            <StackPanel>
                                <Image Source="/Resources/Images/2.png" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Загрузить" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="90" Margin="8" Click="Profile_Click">
                            <StackPanel>
                                <Image Source="/Resources/Images/3.png" Width="30" Height="30" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Профиль" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="90" Margin="8" Click="Stats_Click">
                            <StackPanel>
                                <Image Source="/Resources/Images/4.png" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Статистика" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="90" Margin="8" Click="History_Click">
                            <StackPanel>
                                <Image Source="/Resources/Images/5.png" Width="38" Height="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="История" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="90" Margin="8" Click="Achievements_Click">
                            <StackPanel>
                                <Image Source="/Resources/Images/6.png" Width="40" Height="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Достижения" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="90" Margin="8" Click="Customization_Click">
                            <StackPanel>
                                <Image Source="/Resources/Images/7.png" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Кастомизация" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="90" Margin="8" Click="Settings_Click">
                            <StackPanel>
                                <Image Source="/Resources/Images/8.png" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Настройки" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Button Content="Выйти"
        Height="46"
        Margin="8,20,8,0"
        Click="Logout_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>