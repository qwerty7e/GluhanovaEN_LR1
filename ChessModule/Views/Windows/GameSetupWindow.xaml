<Window x:Class="ChessModule.Windows.GameSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="900" MinHeight="650" Title="Настройка партии" Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" ResizeMode="CanResize">
    <Grid x:Name="RootGrid" Margin="24">
        <StackPanel>
            <TextBlock Text="Новая партия" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBlock Text="Режим игры" Margin="0,22,0,4"/>
            <ComboBox x:Name="ModeCombo" Height="30" SelectionChanged="ModeCombo_SelectionChanged"/>

            <TextBlock Text="Сложность бота" Margin="0,14,0,4"/>
            <ComboBox x:Name="BotCombo" Height="30"/>

            <TextBlock Text="Сложность партии" Margin="0,14,0,4"/>
            <ComboBox x:Name="TimeCombo" Height="30"/>

            <TextBlock Text="Подсказка: в режиме двух игроков оба игрока ходят по очереди за одним устройством."
                       TextWrapping="Wrap" Margin="0,18,0,0"/>

            <Button Content="Начать" Height="36" Margin="0,24,0,0" Click="Start_Click"/>
            <Button Content="Назад" Height="36" Margin="0,10,0,0" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>
