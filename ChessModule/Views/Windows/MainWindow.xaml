<Window x:Class="ChessModule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шахматная партия" Height="760" Width="980" MinHeight="760" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" ResizeMode="CanResize" >
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="360" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderThickness="2" Padding="6" CornerRadius="10" Background="White" Margin="0,0,18,0">
            <Viewbox Stretch="Uniform">
                <UniformGrid x:Name="BoardGrid" Rows="8" Columns="8" Width="760" Height="760"/>
            </Viewbox>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Партия" FontSize="26" FontWeight="Bold"/>
                <TextBlock x:Name="ModeText" FontSize="15" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusText" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"/>

                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Время" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WhiteTimeText" FontSize="16" Margin="0,8,0,0"/>
                        <TextBlock x:Name="BlackTimeText" FontSize="16" Margin="0,4,0,0"/>
                        <TextBlock x:Name="MoveCounterText" FontSize="16" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,18,0,0" Height="300">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ходы" FontSize="18" FontWeight="SemiBold"/>
                        <ListBox x:Name="MovesList" Margin="0,8,0,0"/>
                    </DockPanel>
                </Border>

                <Button Content="Сохранить промежуточно" Height="38" Margin="0,18,0,0" Click="Save_Click"/>
                <Button Content="Сдаться" Height="38" Margin="0,10,0,0" Click="Resign_Click"/>
                <Button Content="Закрыть" Height="38" Margin="0,10,0,0" Click="Close_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
