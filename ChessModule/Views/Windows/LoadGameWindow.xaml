<Window x:Class="ChessModule.Windows.LoadGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="900" MinHeight="650" Title="Продолжить партию" Height="460" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" ResizeMode="CanResize">
    <Grid x:Name="RootGrid" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сохранённые партии" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>

        <DataGrid x:Name="SavesGrid" Grid.Row="1" Margin="0,16,0,16" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding SaveName}" Width="*"/>
                <DataGridTextColumn Header="Режим" Binding="{Binding Mode}" Width="140"/>
                <DataGridTextColumn Header="Сложность" Binding="{Binding GameDifficulty}" Width="150"/>
                <DataGridTextColumn Header="Ходов" Binding="{Binding MoveCount}" Width="70"/>
                <DataGridTextColumn Header="Изменено" Binding="{Binding UpdatedAt}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Продолжить" Width="130" Height="34" Margin="0,0,8,0" Click="Load_Click"/>
            <Button Content="Удалить" Width="110" Height="34" Margin="0,0,8,0" Click="Delete_Click"/>
            <Button Content="Закрыть" Width="110" Height="34" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
